{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at", "actor_type", "action", "target_id", "reason"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^SYN-AUD-[A-Z0-9-]+$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor_type": { "enum": ["system", "agent", "reviewer", "operator"] },
    "action": { "enum": ["generated", "reviewed", "approved", "excluded", "assigned", "exported", "closed"] },
    "target_id": { "type": "string" },
    "reason": { "type": "string", "minLength": 1 },
    "rule_version": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] }
  }
}
